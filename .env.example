# 복사해서 .env 로 저장 (.env 는 git 제외)
OPENAI_API_KEY=
TAVILY_API_KEY=

# 관측 — 프로젝트명 고정. Agent 과제는 kv-cache-agent (RAG 과제는 kv-cache-eval 이었음)
# graph/observe.py 의 태그 · run_name 도 같은 이름 — docs/ROLES.md 「트레이스 캡처 규칙」
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=kv-cache-agent

# 임베딩은 로컬 BGE-M3 — 키 불필요. HF 캐시 경로를 바꾸고 싶으면:
# HF_HOME=
